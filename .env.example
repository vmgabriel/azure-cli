# Copy to `.env` and fill in your personal access token.
# `.env` is git-ignored — never commit a real PAT.

# Azure DevOps organization (the first path segment of https://dev.azure.com/<org>)
AZURE_DEVOPS_ORGANIZATION=serviciosfintech

# Azure DevOps project (team project) holding the work items
AZURE_DEVOPS_PROJECT=bold

# Personal access token with scope "Work Items > Read & Write"
AZURE_DEVOPS_PAT=your-personal-access-token

# REST API version used for every Azure DevOps call
AZURE_DEVOPS_API_VERSION=7.1

# HTTP timeout in seconds
AZURE_DEVOPS_TIMEOUT=15

# Terminal output format: text | json
AZURE_DEVOPS_OUTPUT_FORMAT=text

# E-mail whose work items are shown by `azure-cli mine`
# AZURE_DEVOPS_DEFAULT_EMAIL=you@company.com

# Optional: override the whole API root (Azure DevOps Server / local stubs)
# AZURE_DEVOPS_BASE_URL=https://dev.azure.com/serviciosfintech/bold
